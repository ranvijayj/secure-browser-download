{
  "manifest_version": 3,
  "name": "SecureDL – Password-protected downloads",
  "version": "1.5.0",
  "description": "Save downloads already password-protected. PDFs open in Preview; other files unlock in any browser. 100% local.",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SecureDL",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "short_name": "SecureDL",
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html"
}